{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlay.schema.json",
  "title": "Activation overlay (catalog/overlays/<skill-id>.yaml); metadata only, never edits library files",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "reason", "set"],
  "properties": {
    "schema_version": {"const": 1},
    "skill": {"$ref": "common.schema.json#/$defs/id"},
    "reason": {"type": "string", "minLength": 1},
    "set": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 1536},
        "when_to_use": {"type": "string", "minLength": 1},
        "invocation": {"enum": ["auto", "manual"]},
        "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
