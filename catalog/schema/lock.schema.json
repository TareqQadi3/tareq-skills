{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lock.schema.json",
  "title": "Resolved, pinned skill set (.tareq/skills.lock)",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_version", "generated_at", "project", "catalog", "config_hash", "budget", "targets", "packs", "skills"],
  "properties": {
    "lock_version": {"const": 1},
    "generated_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "project": {"$ref": "common.schema.json#/$defs/id"},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "commit"],
      "properties": {
        "repo": {"$ref": "common.schema.json#/$defs/url"},
        "commit": {"$ref": "common.schema.json#/$defs/commit"},
        "ref": {"type": "string"}
      }
    },
    "config_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_descriptions", "used"],
      "properties": {
        "max_descriptions": {"type": "integer", "minimum": 1},
        "used": {"type": "integer", "minimum": 0}
      }
    },
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/target"}},
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hash"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "hash": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "source", "content_hash", "license", "via"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "version": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["upstream", "local"]},
              "url": {"$ref": "common.schema.json#/$defs/url"},
              "commit": {"$ref": "common.schema.json#/$defs/commit"}
            }
          },
          "content_hash": {"$ref": "common.schema.json#/$defs/sha256"},
          "license": {"type": ["string", "null"]},
          "via": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(include|pack:[a-z0-9]+(-[a-z0-9]+)*)$"}},
          "overlay_hash": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    }
  }
}
