{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-config.schema.json",
  "title": "Client project configuration (.tareq/skills.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "catalog", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"$ref": "common.schema.json#/$defs/id"},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "ref"],
      "properties": {
        "repo": {"$ref": "common.schema.json#/$defs/url"},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "packs": {"$ref": "common.schema.json#/$defs/idList"},
    "include": {"$ref": "common.schema.json#/$defs/idList"},
    "exclude": {"$ref": "common.schema.json#/$defs/idList"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_descriptions": {"type": "integer", "minimum": 1, "default": 40}
      }
    },
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/target"}}
  }
}
